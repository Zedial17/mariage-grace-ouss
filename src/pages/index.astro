---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Countdown from '../components/Countdown.astro';
import Invitation from '../components/Invitation.astro';
import Programme from '../components/Programme.astro';
import Lieux from '../components/Lieux.astro';
import DressCode from '../components/DressCode.astro';
import RsvpForm from '../components/RsvpForm.astro';
import Convives from '../components/Convives.astro';
import Guestbook from '../components/Guestbook.astro';
import Participation from '../components/Participation.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import CtaFlottant from '../components/CtaFlottant.astro';
---

<Base>
  <Header />
  <main>
    <Hero />
    <Countdown />
    <Invitation />
    <Programme />
    <Lieux />
    <DressCode />
    <RsvpForm />
    <Convives />
    <Guestbook />
    <Participation />
    <Faq />
