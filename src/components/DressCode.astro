---
import { tenue } from '../content/site';
---

<section
  id="tenue"
  class="scroll-mt-[70px] border-t border-ivoire/14 px-gutter py-section"
>
  <div class="contenu">
    <div
      class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] items-start gap-bloc"
    >
      <div>
        <div data-filigrane={tenue.filigrane}>
          <div class="text-caption tracking-label text-accent uppercase">
            {tenue.label}
          </div>
          <h2 class="mt-[18px] mb-0 text-h2 font-light tracking-[-.025em]">
            {tenue.titre}
          </h2>
        </div>
        <p class="mt-[22px] mb-0 max-w-[38ch] text-body text-ivoire/78">
          {tenue.texte}
        </p>

        <div class="mt-7 inline-block border border-accent px-[22px] py-[18px]">
          <div class="text-body-tight font-semibold tracking-[.04em]">
            {tenue.regle.titre}
          </div>
          <div class="mt-1 text-body-sm text-ivoire/70">
            {tenue.regle.precision}
          </div>
        </div>

        <p class="mt-[22px] mb-0 max-w-[46ch] text-body-sm text-ivoire/60">
          {tenue.note}
        </p>
      </div>

      <div>
        <div class="text-caption tracking-cap text-ivoire/60 uppercase">
          {tenue.paletteLabel}
        </div>
        <div
          class="mt-4 grid grid-cols-3 gap-px border border-ivoire/14 bg-ivoire/14"
        >
          {
            tenue.palette.map((couleur) => (
              <div class="aspect-square" style={`background:${couleur}`} />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
