---
import { faq } from '../content/site';
---

<section
  id="infos"
  class="contenu scroll-mt-[70px] border-t border-ivoire/14 px-gutter pt-section"
>
  <div data-filigrane={faq.filigrane} class="mb-11">
    <div class="text-caption tracking-label text-accent uppercase">
      {faq.label}
    </div>
    <h2 class="mt-[18px] mb-0 text-h2 font-light tracking-[-.025em]">
      {faq.titre}
    </h2>
  </div>
  <div class="border-t border-ivoire/16">
    {
      faq.questions.map((item) => (
        <details class="border-b border-ivoire/16 py-[22px]">
          {/* -my-[22px] py-[22px] : la zone cliquable couvre toute la ligne
              (72px) sans décaler le texte ni changer la hauteur du bloc. */}
          <summary class="-my-[22px] flex items-center justify-between gap-5 py-[22px] text-subtitle font-normal text-ivoire">
            {item.question}
            <span
              class="qp text-[18px] text-accent transition-transform duration-[250ms]"
              aria-hidden="true"
            >
              →
            </span>
          </summary>
          <p class="mt-3.5 mb-0 max-w-[52ch] text-body text-ivoire/75">
            {item.reponse}
          </p>
        </details>
      ))
    }
  </div>
</section>
