---
/**
 * Icônes d'itinéraire — SVG repris tels quels du HTML de référence.
 * 18×18, trait #CFA184 1,5px.
 */
import type { TypeItineraire } from '../../content/site';

interface Props {
  type: TypeItineraire;
}
const { type } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width="18"
  height="18"
  fill="none"
  stroke="#CFA184"
  stroke-width="1.5"
  stroke-linejoin="round"
  aria-hidden="true"
  class="shrink-0"
>
  {
    type === 'google' && (
      <Fragment>
        <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z" />
        <circle cx="12" cy="10" r="2.5" />
      </Fragment>
    )
  }
  {type === 'waze' && <path d="M20.5 3.5 3.5 10.2l7.1 2.9 2.4 7.4 7.5-17Z" />}
  {
    type === 'apple' && (
      <Fragment>
        <path d="M3 6.5 9 4l6 2.5L21 4v13.5L15 20l-6-2.5L3 20V6.5Z" />
        <path d="M9 4v13.5M15 6.5V20" />
      </Fragment>
    )
  }
</svg>
