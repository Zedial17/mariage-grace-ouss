---
import { convives as texte } from '../content/site';
import { CARTE, TERRES, projeter } from '../content/monde';
import { convives } from '../lib/convives';

/* Instantané pris à la compilation : la carte est visible sans JavaScript.
   Le script la rafraîchit ensuite depuis /api/convives. */
const donnees = await convives();

const arrivee = projeter(texte.destination.lng, texte.destination.lat);

/* Le tracé n'occupe pas tout le viewBox : on recadre sur la bande utile
   pour ne pas laisser de vide au-dessus et en dessous. */
const HAUT = 30;
const BAS = 470;
const viewBox = `0 ${HAUT} ${CARTE.largeur} ${BAS - HAUT}`;

/** Rayon d'un point : croît avec le nombre, sans jamais écraser la carte. */
const rayon = (personnes: number) => Math.min(4 + Math.sqrt(personnes) * 2.6, 14);

const compteurs = [
  { valeur: donnees.personnes, libelle: texte.compteurs.personnes },
  { valeur: donnees.villes.length, libelle: texte.compteurs.villes },
  { valeur: donnees.pays, libelle: texte.compteurs.pays },
];
---

<section
  id="convives"
  class="scroll-mt-[70px] border-t border-ivoire/14 px-gutter py-section"
>
  <div class="contenu">
    <div class="text-caption tracking-label text-accent uppercase">
      {texte.label}
    </div>
    <h2 class="mt-[18px] mb-0 text-h2 font-light tracking-[-.025em]">
      {texte.titre}
    </h2>
    <p class="mt-[22px] mb-0 max-w-[52ch] text-body text-ivoire/78">
      {texte.texte}
    </p>

    {/* ───────── Compteurs ───────── */}
    <div
      class="mt-bloc grid grid-cols-[repeat(auto-fit,minmax(min(100%,150px),1fr))] gap-6 border-y border-ivoire/14 py-compte"
    >
      {
        compteurs.map((c, i) => (
          <div>
            <div
              class="text-compte font-light tracking-[-.02em] tabular-nums"
              data-compteur={i}
            >
              {c.valeur}
            </div>
            <div class="text-caption tracking-compte text-accent uppercase">
              {c.libelle}
            </div>
          </div>
        ))
      }
    </div>

    {/* ───────── La carte ─────────
        Tracé pré-calculé (Natural Earth 1) : aucune bibliothèque de
        cartographie n'est chargée. */}
    <figure class="m-0 mt-bloc">
      <svg
        id="carte-convives"
        viewBox={viewBox}
        class="block w-full"
        role="img"
        aria-label={`${texte.titre} — ${donnees.personnes} ${texte.compteurs.personnes}`}
        data-arrivee-x={arrivee[0]}
        data-arrivee-y={arrivee[1]}
      >
        <path
          d={TERRES}
          fill="none"
          stroke="#F2E6DC"
          stroke-opacity="0.22"
          stroke-width="0.9"
          stroke-linejoin="round"
        ></path>

        {/* Les traits de convergence, puis les villes */}
        <g id="carte-traits" stroke="#CFA184" stroke-opacity="0.3" stroke-width="0.7" fill="none">
          {
            donnees.villes.map((v) => {
              const [x, y] = projeter(v.lng, v.lat);
              return <line x1={x} y1={y} x2={arrivee[0]} y2={arrivee[1]} />;
            })
          }
        </g>

        <g id="carte-villes">
          {
            donnees.villes.map((v) => {
              const [x, y] = projeter(v.lng, v.lat);
              const libelle = `${v.nom} · ${v.personnes} ${
                v.personnes > 1 ? texte.unite.plusieurs : texte.unite.un
              }`;
              return (
                <g>
                  <circle
                    cx={x}
                    cy={y}
                    r={rayon(v.personnes)}
                    fill="#CFA184"
                    fill-opacity="0.16"
                  />
                  <circle cx={x} cy={y} r="2.2" fill="#CFA184">
                    <title>{libelle}</title>
                  </circle>
                </g>
              );
            })
          }
        </g>

        {/* Cabezac — le losange de la charte */}
        <g id="carte-arrivee" transform={`translate(${arrivee[0]} ${arrivee[1]})`}>
          <path
            d="M0 -7 L7 0 L0 7 L-7 0 Z"
            fill="#2E1D15"
            stroke="#F2E6DC"
            stroke-width="1.4"
          >
            <title>{texte.destination.nom}</title>
          </path>
        </g>
      </svg>

      <figcaption
        class="mt-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 text-caption tracking-cap text-ivoire/55 uppercase"
      >
        <span>{texte.legende}</span>
        <span id="carte-vide" hidden={donnees.villes.length > 0} class="text-accent">
          {texte.vide}
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  import { projeter } from '../content/monde';
  import { convives as texte } from '../content/site';

  const svg = document.getElementById('carte-convives');
  const traits = document.getElementById('carte-traits');
  const villes = document.getElementById('carte-villes');
  const vide = document.getElementById('carte-vide');

  if (svg && traits && villes && vide) {
    const NS = 'http://www.w3.org/2000/svg';
    const ax = Number(svg.dataset.arriveeX);
    const ay = Number(svg.dataset.arriveeY);
    const rayon = (n: number) => Math.min(4 + Math.sqrt(n) * 2.6, 14);

    type Ville = { nom: string; pays: string | null; lat: number; lng: number; personnes: number };

    const dessiner = (liste: Ville[]) => {
      traits.replaceChildren();
      villes.replaceChildren();

      for (const v of liste) {
        const [x, y] = projeter(v.lng, v.lat);

        const trait = document.createElementNS(NS, 'line');
        trait.setAttribute('x1', String(x));
        trait.setAttribute('y1', String(y));
        trait.setAttribute('x2', String(ax));
        trait.setAttribute('y2', String(ay));
        traits.append(trait);

        const groupe = document.createElementNS(NS, 'g');
        const halo = document.createElementNS(NS, 'circle');
        halo.setAttribute('cx', String(x));
        halo.setAttribute('cy', String(y));
        halo.setAttribute('r', String(rayon(v.personnes)));
        halo.setAttribute('fill', '#CFA184');
        halo.setAttribute('fill-opacity', '0.16');

        const point = document.createElementNS(NS, 'circle');
        point.setAttribute('cx', String(x));
        point.setAttribute('cy', String(y));
        point.setAttribute('r', '2.2');
        point.setAttribute('fill', '#CFA184');

        const infobulle = document.createElementNS(NS, 'title');
        infobulle.textContent = `${v.nom} · ${v.personnes} ${
          v.personnes > 1 ? texte.unite.plusieurs : texte.unite.un
        }`;
        point.append(infobulle);

        groupe.append(halo, point);
        villes.append(groupe);
      }

      vide.hidden = liste.length > 0;
    };

    const majCompteurs = (valeurs: number[]) =>
      valeurs.forEach((v, i) => {
        const el = svg.ownerDocument.querySelector(`[data-compteur="${i}"]`);
        if (el && el.textContent !== String(v)) el.textContent = String(v);
      });

    /* Rafraîchit la carte quand la section approche, pas avant : inutile
       de solliciter le classeur pour un visiteur qui n'ira pas jusque-là. */
    const charger = async () => {
      try {
        const reponse = await fetch('/api/convives', {
          headers: { accept: 'application/json' },
        });
        if (!reponse.ok) return;
        const corps = await reponse.json();
        if (!corps.ok || !Array.isArray(corps.villes)) return;
        dessiner(corps.villes);
        majCompteurs([corps.personnes, corps.villes.length, corps.pays]);
      } catch {
        /* Hors ligne : l'instantané de la compilation reste affiché. */
      }
    };

    const section = document.getElementById('convives')!;
    if ('IntersectionObserver' in window) {
      const guetteur = new IntersectionObserver(
        (entrees) => {
          if (entrees.some((e) => e.isIntersecting)) {
            guetteur.disconnect();
            charger();
          }
        },
        { rootMargin: '400px' },
      );
      guetteur.observe(section);
    } else {
      charger();
    }
  }
</script>
