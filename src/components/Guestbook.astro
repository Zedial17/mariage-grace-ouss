---
import { livreDor } from '../content/site';

const { verrou } = livreDor;

const champ =
  'border-b border-ivoire/30 bg-transparent py-2.5 text-field text-ivoire outline-none';
const label = 'text-caption tracking-cap text-accent uppercase';

/* Site statique : la liste arrive du classeur au chargement de la page,
   par le script en bas de ce fichier. */
---

<section
  id="mots"
  class="scroll-mt-[70px] border-t border-ivoire/14 py-section"
>
  <div class="contenu px-gutter">
    <div
      class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6"
    >
      <div class="grow">
        <div data-filigrane={livreDor.filigrane}>
          <div class="text-caption tracking-label text-accent uppercase">
            {livreDor.label}
          </div>
          <h2 class="mt-[18px] mb-0 text-h2 font-light tracking-[-.025em]">
            {livreDor.titre}
          </h2>
        </div>
        <p class="mt-[22px] mb-0 max-w-[38ch] text-body text-ivoire/78">
          {livreDor.texte}
        </p>
      </div>

      {/* Compteur — avec le reste, sous clé */}
      <div id="mots-nav" hidden class="flex items-center gap-4">
        <span
          id="mots-compteur"
          aria-live="polite"
          class="text-caption tracking-cap text-ivoire/55 uppercase tabular-nums"
        ></span>
      </div>
    </div>
  </div>

  {/* ───────── Le verrou ─────────
      Les mots des invités ne s'affichent qu'avec le code du faire-part.
      Rien de bien gardé — le code vit dans la page — mais la section
      reste entre nous, et le classeur n'est appelé qu'une fois ouverte. */}
  <div id="mots-verrou" class="contenu mt-bloc-mots px-gutter">
    <div
      class="mx-auto flex max-w-[440px] flex-col items-center gap-6 border border-ivoire/18 px-6 py-11 text-center"
    >
      <svg
        viewBox="0 0 56 64"
        width="40"
        height="46"
        fill="none"
        stroke="#CFA184"
        stroke-width="1.6"
        stroke-linejoin="round"
        aria-hidden="true"
        class="shrink-0"
      >
        <path
          id="mots-anse"
          d="M16 28 V18 a12 12 0 0 1 24 0 v10"
          stroke-linecap="round"
          class="origin-[40px_28px] transition-transform duration-500 [transform-box:view-box]"
        ></path>
        <rect x="8" y="28" width="40" height="30" rx="2"></rect>
        <circle cx="28" cy="40" r="3.5"></circle>
        <path d="M28 43.5 V49" stroke-linecap="round"></path>
      </svg>

      <p class="m-0 text-body text-ivoire/78">{verrou.texte}</p>

      <form id="mots-verrou-form" novalidate class="flex w-full max-w-[300px] gap-3">
        <input
          id="mots-code"
          type="password"
          autocomplete="off"
          maxlength="40"
          placeholder={verrou.champ}
          aria-label={verrou.champ}
          class="min-w-0 flex-1 border-b border-ivoire/30 bg-transparent py-2 text-center text-body tracking-[.08em] text-ivoire outline-none transition-colors duration-200 focus:border-ivoire"
        />
        <button
          type="submit"
          class="shrink-0 cursor-pointer rounded-btn border border-accent bg-transparent px-5 py-2.5 text-caption font-semibold tracking-bouton text-accent uppercase hover:bg-accent hover:text-brun active:translate-y-px"
          >{verrou.bouton}</button
        >
      </form>

      <p id="mots-verrou-erreur" hidden role="alert" class="m-0 text-body-sm text-accent">
        {verrou.erreur}
      </p>
    </div>
  </div>

  <div id="mots-contenu" hidden>
  {/* ───────── La roue de cartes ─────────
      Les mots sont posés sur un grand cercle à demi enterré, que le
      défilement fait tourner. Sans JavaScript — ou si le visiteur
      demande moins d'animations — ils restent en liste. */}
  <div id="mots-piste" class="relative mt-bloc-mots">
    <div
      id="mots-scene"
      class="relative overflow-hidden [mask-image:linear-gradient(to_top,transparent_0,black_30%,black_100%)]"
    >
      <ul id="mots-roue" class="mots-roue"></ul>
    </div>
  </div>

  <p
    id="mots-vide"
    hidden
    class="contenu mt-bloc-mots mb-0 px-gutter text-body text-ivoire/55"
  >
    {livreDor.vide}
  </p>

  {/* ───────── Déposer un mot ───────── */}
  <div class="contenu mt-bloc-mots px-gutter">
    <form
      id="mots-form"
      novalidate
      class="grid max-w-[560px] grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-x-6 gap-y-[18px] border-t border-ivoire/16 pt-8"
    >
      <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
        <label>
          Ne pas remplir
          <input type="text" name="site_web" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <label class="flex flex-col gap-2">
        <span class={label}>{livreDor.champs.nom}</span>
        <input type="text" name="nom" autocomplete="name" maxlength="120" class={champ} />
      </label>

      <label class="col-span-full flex flex-col gap-2">
        <span class={label}>{livreDor.champs.message}</span>
        <textarea
          name="texte"
          rows="2"
          maxlength="2000"
          required
          aria-describedby="err-mot"
          class:list={[champ, 'resize-y']}></textarea>
        <span id="err-mot" hidden role="alert" class="text-body-sm text-accent"></span>
      </label>

      <div class="col-span-full">
        <button
          type="submit"
          class="cursor-pointer rounded-btn border border-accent bg-transparent px-[30px] py-[15px] text-body-sm font-semibold tracking-bouton text-accent uppercase hover:bg-accent hover:text-brun active:translate-y-px disabled:cursor-wait disabled:opacity-60"
          >{livreDor.champs.envoyer}</button
        >
      </div>
    </form>
  </div>
  </div>
</section>

<template id="mots-gabarit">
  <li>
    <article
      class="flex min-h-[250px] w-[182px] flex-col rounded-[3px] border border-brun/12 bg-ivoire px-[18px] py-5 text-brun shadow-[0_14px_36px_rgba(20,11,7,.42)] sm:min-h-[310px] sm:w-[240px] sm:px-7 sm:py-7"
    >
      <div class="flex items-baseline justify-between gap-4">
        <span
          class="text-caption tracking-cap text-brun/40 tabular-nums"
          data-numero></span>
        <span class="text-[18px] text-cuivre" aria-hidden="true">◇</span>
      </div>
      <p
        class="mt-4 mb-0 line-clamp-6 grow text-[15px]/[23px] font-light sm:mt-5 sm:text-mot"
        data-texte></p>
      <div
        class="mt-5 flex flex-wrap items-baseline gap-x-2.5 gap-y-1 border-t border-brun/12 pt-3.5"
      >
        <span class="text-caption tracking-cap text-cuivre uppercase" data-nom></span>
        <span
          class="text-caption tracking-note text-brun/45 uppercase"
          data-attente
          hidden></span>
      </div>
    </article>
  </li>
</template>

<script>
  import { lireMessage, validerMessage, aDesErreurs } from '../lib/validation';
  import { appeler, classeurConfigure, type MessagePublie } from '../lib/classeur';
  import { livreDor, reseau } from '../content/site';

  const form = document.getElementById('mots-form') as HTMLFormElement | null;
  const roue = document.getElementById('mots-roue');
  const piste = document.getElementById('mots-piste');
  const scene = document.getElementById('mots-scene');
  const vide = document.getElementById('mots-vide');
  const compteur = document.getElementById('mots-compteur');
  const gabarit = document.getElementById('mots-gabarit') as HTMLTemplateElement | null;
  const erreur = document.getElementById('err-mot');

  if (form && roue && piste && scene && vide && compteur && gabarit && erreur) {
    const bouton = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const tourne = !matchMedia('(prefers-reduced-motion: reduce)').matches;

    const numero = (i: number) => String(i + 1).padStart(2, '0');

    const carte = (nom: string, texte: string, index: number, enAttente: boolean) => {
      const noeud = gabarit.content.cloneNode(true) as DocumentFragment;
      noeud.querySelector<HTMLElement>('[data-numero]')!.textContent = numero(index);
      noeud.querySelector<HTMLElement>('[data-texte]')!.textContent = texte;
      noeud.querySelector<HTMLElement>('[data-nom]')!.textContent = nom;
      const attente = noeud.querySelector<HTMLElement>('[data-attente]')!;
      attente.hidden = !enAttente;
      if (enAttente) attente.textContent = `· ${livreDor.mentionAttente}`;
      return noeud;
    };

    /* ───────── La roue ─────────
       Les cartes se posent sur un cercle dont les trois cinquièmes bas
       sont enterrés ; le défilement de la page le fait tourner, carte
       après carte. Géométrie reprise du livre d'or du site Emma. */
    const VISIBLE = 0.42; // part du cercle qui dépasse de la scène
    const PAS_MAX = 30; // degrés entre deux cartes
    const PX_PAR_DEGRE = 5; // longueur de défilement d'un cran

    const rayon = () => (innerWidth < 768 ? 215 : 470);
    let amplitude = 0; // degrés parcourus par un tour complet de lecture
    let hautCollant = 0;

    const cartes = () => [...roue.querySelectorAll<HTMLElement>('li')];

    const poser = () => {
      const liste = cartes();
      roue.classList.toggle('est-roue', tourne && liste.length > 0);

      if (!tourne || liste.length === 0) {
        // Mode liste : on rend la main au flux normal.
        for (const li of liste) li.style.transform = '';
        roue.style.cssText = '';
        scene.style.height = '';
        scene.style.top = '';
        piste.style.height = '';
        return;
      }

      const r = rayon();
      const d = r * 2;
      const pas = Math.min(PAS_MAX, 360 / liste.length);
      amplitude = pas * (liste.length - 1);

      roue.style.width = `${d}px`;
      roue.style.height = `${d}px`;
      roue.style.bottom = `${-d * (1 - VISIBLE)}px`;

      liste.forEach((li, i) => {
        // −90° : la première carte se présente en haut du cercle.
        const angle = ((i * pas - 90) * Math.PI) / 180;
        const x = (r * Math.cos(angle)).toFixed(1);
        const y = (r * Math.sin(angle)).toFixed(1);
        li.style.transform = `translate(-50%, -50%) translate(${x}px, ${y}px) rotate(${i * pas}deg)`;
      });

      const hauteurCarte = liste[0].offsetHeight || 280;
      const hauteurScene = Math.round(d * VISIBLE + hauteurCarte / 2 + 80);
      scene.style.height = `${hauteurScene}px`;

      // La scène se fige au milieu de l'écran le temps du tour.
      hautCollant = Math.max(80, Math.round((innerHeight - hauteurScene) / 2));
      scene.style.position = 'sticky';
      scene.style.top = `${hautCollant}px`;
      piste.style.height = `${hauteurScene + Math.round(amplitude * PX_PAR_DEGRE)}px`;

      tourner();
    };

    const tourner = () => {
      if (!roue.classList.contains('est-roue')) return;
      const course = piste.offsetHeight - scene.offsetHeight;
      const avance =
        course > 0
          ? Math.min(1, Math.max(0, (hautCollant - piste.getBoundingClientRect().top) / course))
          : 0;
      roue.style.transform = `rotate(${-avance * amplitude}deg)`;
    };

    let enAttenteDeTrame = false;
    const tournerPlusTard = () => {
      if (enAttenteDeTrame) return;
      enAttenteDeTrame = true;
      requestAnimationFrame(() => {
        enAttenteDeTrame = false;
        tourner();
      });
    };

    /** Compteur et état vide, d'après le contenu de la roue. */
    const majEtat = () => {
      const n = cartes().length;
      vide.hidden = n > 0;
      compteur.textContent = n
        ? `${n} ${n > 1 ? livreDor.rail.plusieurs : livreDor.rail.un}`
        : '';
      poser();
    };

    /** Recharge les messages publiés sans toucher à ceux en attente. */
    const rafraichir = async () => {
      const corps = await appeler<{ messages: MessagePublie[] }>('messages');
      if (!corps.ok || !Array.isArray(corps.messages)) {
        majEtat();
        return;
      }

      // On garde les mots déposés pendant la visite, pas encore publiés.
      const enAttente = cartes().filter(
        (li) => li.querySelector('[data-attente]')?.hasAttribute('hidden') === false,
      );

      roue.replaceChildren();
      enAttente.forEach((li) => roue.append(li));
      corps.messages.forEach((m, i) =>
        roue.append(carte(m.nom, m.texte, enAttente.length + i, false)),
      );
      majEtat();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      erreur.hidden = true;

      const brut = Object.fromEntries(new FormData(form).entries());
      const donnees = lireMessage(brut);

      const erreurs = validerMessage(donnees);
      if (aDesErreurs(erreurs)) {
        erreur.textContent = erreurs.texte!;
        erreur.hidden = false;
        (form.elements.namedItem('texte') as HTMLTextAreaElement).focus();
        return;
      }

      bouton.disabled = true;
      const libelle = bouton.textContent;
      bouton.textContent = reseau.enCours;

      if (String(brut.site_web ?? '')) {
        form.reset();
        return;
      }

      try {
        const corps = await appeler('message', { nom: donnees.nom, texte: donnees.texte });

        if (corps.ok) {
          // Affichage local : le message n'est pas encore publié.
          roue.prepend(carte(donnees.nom, donnees.texte, 0, true));
          majEtat();
          piste.scrollIntoView({ block: 'center', behavior: 'smooth' });
          form.reset();
          return;
        }

        erreur.textContent = classeurConfigure
          ? ((corps as { message?: string }).message ?? reseau.echec)
          : reseau.indisponible;
        erreur.hidden = false;
      } catch {
        erreur.textContent = reseau.echec;
        erreur.hidden = false;
      } finally {
        bouton.disabled = false;
        bouton.textContent = libelle;
      }
    });

    let minuteur = 0;
    const majPlusTard = () => {
      clearTimeout(minuteur);
      minuteur = window.setTimeout(poser, 150);
    };

    addEventListener('scroll', tournerPlusTard, { passive: true });
    addEventListener('resize', majPlusTard, { passive: true });

    /* ───────── Le verrou ─────────
       La comparaison ignore la casse et les espaces, et confond le zéro
       avec la lettre O : « G&O2027 » et « g&02027 » ouvrent la même
       porte. Le classeur n'est appelé qu'une fois la section ouverte. */
    const normalise = (valeur: string) =>
      valeur.trim().toUpperCase().replace(/\s+/g, '').replace(/0/g, 'O');

    const attendu = normalise(livreDor.verrou.code);
    const CLE = 'mots-ouvert';

    const verrou = document.getElementById('mots-verrou');
    const verrouForm = document.getElementById('mots-verrou-form') as HTMLFormElement | null;
    const code = document.getElementById('mots-code') as HTMLInputElement | null;
    const verrouErreur = document.getElementById('mots-verrou-erreur');
    const contenu = document.getElementById('mots-contenu');
    const nav = document.getElementById('mots-nav');

    if (verrou && verrouForm && code && verrouErreur && contenu && nav) {
      const carteVerrou = verrou.firstElementChild as HTMLElement | null;
      const anse = document.getElementById('mots-anse');
      const anime = !matchMedia('(prefers-reduced-motion: reduce)').matches;

      // La navigation privée interdit sessionStorage : on s'en passe.
      const dejaOuvert = () => {
        try {
          return sessionStorage.getItem(CLE) === '1';
        } catch {
          return false;
        }
      };
      const retenir = () => {
        try {
          sessionStorage.setItem(CLE, '1');
        } catch {
          /* tant pis, le code sera redemandé */
        }
      };

      const reveler = () => {
        verrou.hidden = true;
        contenu.hidden = false;
        nav.hidden = false;
        // La roue ne se mesure qu'une fois la section à l'écran.
        majEtat();
        rafraichir();
      };

      const ouvrir = () => {
        retenir();
        if (!anime) return reveler();

        // L'anse s'écarte, puis le verrou s'efface.
        if (anse) anse.style.transform = 'translateY(-5px) rotate(16deg)';
        verrou.style.transition = 'opacity .35s ease';
        setTimeout(() => {
          verrou.style.opacity = '0';
          setTimeout(reveler, 350);
        }, 450);
      };

      verrouForm.addEventListener('submit', (e) => {
        e.preventDefault();
        if (normalise(code.value) === attendu) return ouvrir();

        verrouErreur.hidden = false;
        code.value = '';
        code.focus();
        // Relancer l'animation, même au deuxième refus.
        carteVerrou?.classList.remove('animate-secousse');
        void carteVerrou?.offsetWidth;
        carteVerrou?.classList.add('animate-secousse');
      });

      carteVerrou?.addEventListener('animationend', () =>
        carteVerrou.classList.remove('animate-secousse'),
      );
      code.addEventListener('input', () => {
        verrouErreur.hidden = true;
      });

      if (dejaOuvert()) reveler();
    } else {
      rafraichir();
    }
  }
</script>
