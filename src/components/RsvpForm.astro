---
import { rsvp } from '../content/site';

/* Pastilles de choix : la bordure et le fond basculent avec la radio
   masquée (peer), sans JavaScript. */
const pill =
  'block cursor-pointer rounded-btn border px-6 py-[15px] text-center text-body-sm font-semibold tracking-bouton uppercase transition-colors duration-200 border-brun/25 bg-transparent text-brun hover:border-brun/60 peer-checked:border-brun peer-checked:bg-brun peer-checked:text-ivoire peer-focus-visible:outline-2 peer-focus-visible:outline-offset-[3px] peer-focus-visible:outline-cuivre';
const champ =
  'border-b border-brun/25 bg-transparent py-2.5 text-field text-brun outline-none transition-colors duration-200 placeholder:text-brun/35 focus:border-brun';
const label = 'text-caption tracking-cap text-cuivre uppercase';
const erreur = 'hidden text-body-sm text-cuivre';
const aide = 'text-body-sm text-brun/60';
const duo = 'grid max-w-[460px] grid-cols-2 gap-2.5';
---

<section
  id="rsvp"
  class="scroll-mt-[70px] bg-ivoire px-gutter py-section text-brun"
>
  <div class="mx-auto max-w-[680px]">
    <div class="text-caption tracking-label text-cuivre uppercase">
      {rsvp.label}
    </div>
    <h2 class="mt-[18px] mb-0 text-h2 font-light tracking-[-.025em] text-balance">
      {rsvp.titre}
    </h2>
    <p class="mt-4 mb-0 text-caption tracking-cap text-brun/55 uppercase">
      {rsvp.dateLimite}
    </p>

    {/* État envoyé */}
    <div
      id="rsvp-merci"
      hidden
      tabindex="-1"
      class="mt-14 border-t border-brun/15 pt-14"
    >
      <div class="text-h3 font-light tracking-[-.02em]">
        {rsvp.confirmation.titre}
      </div>
      <p class="mt-3 mb-0 text-body text-brun/70">{rsvp.confirmation.texte}</p>
    </div>

    <div id="rsvp-bloc" class="mt-12 border-t border-brun/15 pt-12">
      <form id="rsvp-form" novalidate class="grid gap-[38px]">
        {/* Anti-spam : piège à robots, invisible et hors du flux de tabulation. */}
        <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
          <label>
            Ne pas remplir
            <input type="text" name="site_web" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        {/* ───────────── La réponse d'abord ───────────── */}
        <fieldset class="m-0 border-0 p-0">
          <legend class={label}>{rsvp.champs.reponse}</legend>
          <div class:list={['mt-3.5', duo]}>
            <label>
              <input type="radio" name="reponse" value="oui" class="peer sr-only" />
              <span class={pill}>{rsvp.champs.oui}</span>
            </label>
            <label>
              <input type="radio" name="reponse" value="non" class="peer sr-only" />
              <span class={pill}>{rsvp.champs.non}</span>
            </label>
          </div>
          <span id="err-reponse" class:list={['mt-3 block', erreur]}>
            {rsvp.erreurs.reponse}
          </span>
        </fieldset>

        {/* ───────────── Qui répond ───────────── */}
        <div
          class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))] gap-[38px]"
        >
          <label class="flex flex-col gap-2">
            <span class={label}>{rsvp.champs.nom}</span>
            <input
              type="text"
              name="nom"
              autocomplete="name"
              maxlength="120"
              required
              aria-describedby="err-nom"
              class={champ}
            />
            <span id="err-nom" class={erreur}>{rsvp.erreurs.nom}</span>
          </label>

          <label class="flex flex-col gap-2">
            <span class={label}>{rsvp.champs.email}</span>
            <input
              type="email"
              name="email"
              autocomplete="email"
              maxlength="160"
              required
              aria-describedby="err-email"
              class={champ}
            />
            <span id="err-email" class={erreur}>{rsvp.erreurs.email}</span>
          </label>
        </div>

        {/* ───────────── Réservé à ceux qui viennent ─────────────
            Inutile de demander un accompagnant ou une ville de départ
            à quelqu'un qui vient de nous dire qu'il ne pourra pas. */}
        <div id="rsvp-presence" class="grid gap-[38px]">
          <fieldset class="m-0 border-0 p-0">
            <legend class={label}>{rsvp.champs.accompagnant}</legend>
            <div class:list={['mt-3.5', duo]}>
              <label>
                <input
                  type="radio"
                  name="accompagnant"
                  value="seul"
                  checked
                  class="peer sr-only"
                />
                <span class={pill}>{rsvp.champs.seul}</span>
              </label>
              <label>
                <input
                  type="radio"
                  name="accompagnant"
                  value="plus"
                  class="peer sr-only"
                />
                <span class={pill}>{rsvp.champs.avecUn}</span>
              </label>
            </div>
            <p class:list={['mt-3 mb-0', aide]}>{rsvp.champs.limite}</p>

            <label id="bloc-accompagnant" hidden class="mt-7 flex flex-col gap-2">
              <span class={label}>{rsvp.champs.nomAccompagnant}</span>
              <input
                type="text"
                name="nom_accompagnant"
                maxlength="120"
                aria-describedby="err-nom_accompagnant"
                class={champ}
              />
              <span id="err-nom_accompagnant" class={erreur}>
                {rsvp.erreurs.nomAccompagnant}
              </span>
            </label>
          </fieldset>

          <label class="flex flex-col gap-2">
            <span class={label}>
              {rsvp.champs.ville}
              <span class="text-brun/40"> · {rsvp.champs.facultatif}</span>
            </span>
            <input
              type="text"
              name="ville"
              autocomplete="address-level2"
              maxlength="120"
              placeholder={rsvp.champs.villeExemple}
              class={champ}
            />
          </label>
        </div>

        {/* ───────────── Un mot ───────────── */}
        <label class="flex flex-col gap-2">
          <span class={label}>
            {rsvp.champs.mot}
            <span class="text-brun/40"> · {rsvp.champs.facultatif}</span>
          </span>
          <textarea
            name="message"
            rows="3"
            maxlength="2000"
            placeholder={rsvp.champs.motExemple}
            class:list={[champ, 'resize-y']}></textarea>
        </label>

        <div class="mt-2 border-t border-brun/15 pt-9">
          <button
            type="submit"
            id="rsvp-envoyer"
            class="cursor-pointer rounded-btn bg-brun px-11 py-[17px] text-body-sm font-semibold tracking-bouton text-ivoire uppercase transition-colors duration-200 hover:bg-cuivre active:translate-y-px disabled:cursor-wait disabled:opacity-60"
            >{rsvp.champs.envoyer}</button
          >
          <p
            id="rsvp-echec"
            hidden
            role="alert"
            class="mt-5 mb-0 text-body-sm text-cuivre"
          >
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { validerRsvp, lireRsvp, aDesErreurs } from '../lib/validation';
  import { appeler, classeurConfigure } from '../lib/classeur';
  import { reseau } from '../content/site';

  const form = document.getElementById('rsvp-form') as HTMLFormElement | null;
  const bloc = document.getElementById('rsvp-bloc');
  const merci = document.getElementById('rsvp-merci');
  const echec = document.getElementById('rsvp-echec');
  const envoyer = document.getElementById('rsvp-envoyer') as HTMLButtonElement | null;
  const blocPresence = document.getElementById('rsvp-presence');
  const blocAccompagnant = document.getElementById('bloc-accompagnant');

  if (form && bloc && merci && echec && envoyer && blocPresence && blocAccompagnant) {
    const CHAMPS = ['nom', 'email', 'reponse', 'nom_accompagnant'] as const;

    const montre = (id: string, visible: boolean, message?: string) => {
      const el = document.getElementById(id);
      if (!el) return;
      if (message) el.textContent = message;
      el.classList.toggle('hidden', !visible);
    };

    const afficheErreurs = (erreurs: Record<string, string | undefined>) => {
      CHAMPS.forEach((c) => montre(`err-${c}`, Boolean(erreurs[c]), erreurs[c]));
      const premier = CHAMPS.find((c) => erreurs[c]);
      if (premier) {
        const el = document.getElementById(`err-${premier}`);
        el?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        form.querySelector<HTMLElement>(`[name="${premier}"]`)?.focus();
      }
      return Boolean(premier);
    };

    const valeur = (nom: string) =>
      (form.elements.namedItem(nom) as RadioNodeList | null)?.value ?? '';

    /* Accompagnant : révèle le champ du nom. */
    const majAccompagnant = () => {
      const avec = valeur('accompagnant') === 'plus';
      blocAccompagnant.hidden = !avec;
      if (!avec) {
        (form.elements.namedItem('nom_accompagnant') as HTMLInputElement).value = '';
        montre('err-nom_accompagnant', false);
      }
    };

    /* Empêché(e) : on ne demande ni accompagnant ni ville de départ. */
    const majPresence = () => {
      const present = valeur('reponse') !== 'non';
      blocPresence.hidden = !present;
      if (!present) {
        (form.elements.namedItem('accompagnant') as RadioNodeList).value = 'seul';
        (form.elements.namedItem('ville') as HTMLInputElement).value = '';
        majAccompagnant();
      }
    };

    form.querySelectorAll('input[name="accompagnant"]').forEach((radio) =>
      radio.addEventListener('change', majAccompagnant),
    );

    form.querySelectorAll('input[name="reponse"]').forEach((radio) =>
      radio.addEventListener('change', () => {
        montre('err-reponse', false);
        majPresence();
      }),
    );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      echec.hidden = true;

      const brut = Object.fromEntries(new FormData(form).entries());
      const donnees = lireRsvp(brut);

      const erreurs = validerRsvp(donnees);
      if (aDesErreurs(erreurs)) return void afficheErreurs(erreurs);
      afficheErreurs({});

      envoyer.disabled = true;
      const libelle = envoyer.textContent;
      envoyer.textContent = reseau.enCours;

      // Piège à robots : on fait comme si, sans rien envoyer.
      if (String(brut.site_web ?? '')) {
        bloc.hidden = true;
        merci.hidden = false;
        return;
      }

      try {
        const corps = await appeler('rsvp', {
          nom: donnees.nom,
          email: donnees.email,
          ville: donnees.ville,
          reponse: donnees.reponse,
          accompagnant: donnees.accompagnant,
          nom_accompagnant: donnees.accompagnant ? donnees.nom_accompagnant : '',
          message: donnees.message,
        });

        if (corps.ok) {
          bloc.hidden = true;
          merci.hidden = false;
          merci.focus();
          return;
        }

        echec.textContent = classeurConfigure
          ? ((corps as { message?: string }).message ?? reseau.echec)
          : reseau.indisponible;
        echec.hidden = false;
      } catch {
        echec.textContent = reseau.echec;
        echec.hidden = false;
      } finally {
        envoyer.disabled = false;
        envoyer.textContent = libelle;
      }
    });

    majPresence();
    majAccompagnant();
  }
</script>
