---
import { invitation } from '../content/site';
---

<section class="contenu px-gutter py-section-lg text-center">
  <div class="text-caption tracking-label text-accent uppercase">
    {invitation.label}
  </div>
  <p
    class="mx-auto mt-10 mb-0 max-w-[22ch] text-citation font-light tracking-[-.01em]"
  >
    {invitation.citation}
  </p>
  {
    invitation.texte && (
      <p class="mx-auto mt-[26px] mb-0 max-w-[48ch] text-body text-ivoire/72">
        {invitation.texte}
      </p>
    )
  }
</section>
