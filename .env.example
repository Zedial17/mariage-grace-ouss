# ------------------------------------------------------------------
#  Grace & Ouss — variables de compilation
#  Copier ce fichier en « .env ». Le .env n'est jamais versionné.
# ------------------------------------------------------------------

# URL de l'application web Apps Script liée au Google Sheet.
# Apps Script → Déployer → Nouveau déploiement → Application web,
# puis copier l'URL qui se termine par /exec.
#
# ⚠ PUBLIC_ : cette URL est embarquée dans la page et donc visible de
#   tous. C'est inévitable sur un site sans serveur — c'est le script
#   lui-même qui limite ce qu'un visiteur peut faire.
PUBLIC_SHEETS_ENDPOINT="https://script.google.com/macros/s/AKfycb.../exec"

# Adresse publique du site et sous-dossier éventuel.
# Sur GitHub Pages depuis un dépôt de projet :
#   SITE_URL=https://zedial17.github.io
#   BASE_PATH=/mariage-grace-ouss
# Avec un vrai nom de domaine : SITE_URL=https://… et BASE_PATH vide.
SITE_URL="https://zedial17.github.io"
BASE_PATH="/mariage-grace-ouss"
