# ------------------------------------------------------------------
#  Grace & Ouss — variables d'environnement
#  Copier ce fichier en « .env » et remplir les trois valeurs.
#  Le .env n'est jamais versionné (voir .gitignore).
# ------------------------------------------------------------------

# URL de l'application web Apps Script liée au Google Sheet.
# Apps Script → Déployer → Nouveau déploiement → Application web,
# puis copier l'URL qui se termine par /exec.
SHEETS_ENDPOINT="https://script.google.com/macros/s/AKfycb.../exec"

# Jeton partagé : exactement la même valeur que la variable JETON
# en haut de google-apps-script/Code.gs.
# Il empêche n'importe qui d'écrire dans le classeur en devinant l'URL.
SHEETS_TOKEN="un-jeton-long-et-unique"

# Mot de passe de la page /admin. Choisissez-en un long et unique.
# Le changer déconnecte immédiatement toutes les sessions ouvertes.
ADMIN_PASSWORD="un-mot-de-passe-long-et-unique"
